From 53452fa3315f10c02c0260efe032e3e6ef398779 Mon Sep 17 00:00:00 2001
From: Hao Lin <hao.lin@samsung.com>
Date: Wed, 4 Nov 2026 22:05:39 +0800
Subject: [PATCH 3/9] zram: retain the selected backend when a setting is
 unavailable

A fixed lz4 fallback cannot initialize a kernel with only the LZO
backend. After EINVAL or an initialized-device EBUSY, read and validate
the bracketed kernel-selected algorithm and retain it without another
algorithm write. Permission, I/O, read and malformed-list errors still
fail. Existing nonzero disksize handling and all function names remain.
The configured zstd succeeds on the lz4/zstd kernel; the LZO-only kernel
retains its own default. No unavailable fallback algorithm is guessed.

Based on analysis of He Fangyu's fix 16d6125d
---
 src/resource-optimizer/memory/swap/zramswap.c | 30 +++++++++++--------
 1 file changed, 18 insertions(+), 12 deletions(-)

diff --git a/src/resource-optimizer/memory/swap/zramswap.c b/src/resource-optimizer/memory/swap/zramswap.c
index 8d24cd1..d3f44aa 100644
--- a/src/resource-optimizer/memory/swap/zramswap.c
+++ b/src/resource-optimizer/memory/swap/zramswap.c
@@ -111,20 +111,26 @@ static int swap_zram_activate(void *data)
 
 	r = fwrite_str(SWAP_ZRAM_COMP_ALGORITHM,
 				zram_control.comp_algorithm);
-	if (r < 0) {
-		/*
-		 * if it fails to set compressor described in .conf file,
-		 * then try again with default compressor.
+	if (r == -EINVAL || r == -EBUSY) {
+		char buf[LINE_MAX], *algorithms = buf;
+		char *selected, *end;
+
+		/* Backends differ between kernels. Keep the kernel-selected
+		 * algorithm instead of trying an unavailable fixed fallback.
+		 * EBUSY means an initialized device must retain its algorithm.
 		 */
-		_I("failed to write comp_algorithm: %s, try default: %s",
-						zram_control.comp_algorithm,
-						DEFAULT_ZRAM_COMPRESSOR);
-		r = fwrite_str(SWAP_ZRAM_COMP_ALGORITHM,
-				DEFAULT_ZRAM_COMPRESSOR);
-		if (r < 0) {
-			_E("fail to write comp_algrithm");
+		r = fread_str(SWAP_ZRAM_COMP_ALGORITHM, &algorithms);
+		if (r < 0)
 			return r;
-		}
+		selected = strchr(algorithms, '[');
+		end = selected ? strchr(selected + 1, ']') : NULL;
+		if (!end || end == selected + 1)
+			return -ENODATA;
+		*end = '\0';
+		_W("Cannot apply configured algorithm %s; retaining kernel algorithm %s",
+				zram_control.comp_algorithm, selected + 1);
+	} else if (r < 0) {
+		return r;
 	}
 
 	r = fread_ulonglong(SWAP_ZRAM_DISK_SIZE, &read_size_bytes);
