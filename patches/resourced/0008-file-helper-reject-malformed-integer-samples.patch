From 879c021f9daac03875c5919f5456876e741885ed Mon Sep 17 00:00:00 2001
From: Hao Lin <hao.lin@samsung.com>
Date: Wed, 4 Nov 2026 22:05:40 +0800
Subject: [PATCH 8/9] file-helper: reject malformed integer samples

fscanf returning zero leaves the temporary value unassigned, but the
helpers reported success and copied it to callers. Require one converted
field for each of the four existing signed/unsigned integer readers.
Leave caller output unchanged on failure, including memory usage reads.

Based on analysis of He Fangyu's fix 16d6125d
---
 src/common/file-helper.c         |  8 ++++++
 tests/CMakeLists.txt             |  2 ++
 tests/test-integer-read-errors.c | 46 ++++++++++++++++++++++++++++++++
 3 files changed, 56 insertions(+)
 create mode 100644 tests/test-integer-read-errors.c

diff --git a/src/common/file-helper.c b/src/common/file-helper.c
index 7281672..db92e00 100644
--- a/src/common/file-helper.c
+++ b/src/common/file-helper.c
@@ -160,6 +160,8 @@ int fread_nth_int(const char *path, size_t n, int32_t *number)
 		ret = fscanf(f, "%d", &t);
 		ret_value_errno_msg_if(ret == EOF, -(errno ?: ENOENT),
 				       "Fail to read file\n");
+		ret_value_msg_if(ret != 1, -EINVAL,
+				 "Invalid integer in file %s at index %zu", path, i);
 	}
 
 	*number = t;
@@ -182,6 +184,8 @@ int fread_nth_uint(const char *path, size_t n, u_int32_t *number)
 		ret = fscanf(f, "%u", &t);
 		ret_value_errno_msg_if(ret == EOF, -(errno ?: ENOENT),
 				       "Fail to read file\n");
+		ret_value_msg_if(ret != 1, -EINVAL,
+				 "Invalid integer in file %s at index %zu", path, i);
 	}
 
 	*number = t;
@@ -204,6 +208,8 @@ int fread_nth_ulong(const char *path, size_t n, unsigned long *number)
 		ret = fscanf(f, "%lu", &t);
 		ret_value_errno_msg_if(ret == EOF, -(errno ?: ENOENT),
 				       "Fail to read file\n");
+		ret_value_msg_if(ret != 1, -EINVAL,
+				 "Invalid integer in file %s at index %zu", path, i);
 	}
 
 	*number = t;
@@ -226,6 +232,8 @@ int fread_nth_ulonglong(const char *path, size_t n, unsigned long long *number)
 		ret = fscanf(f, "%llu", &t);
 		ret_value_errno_msg_if(ret == EOF, -(errno ?: ENOENT),
 				       "Fail to read file\n");
+		ret_value_msg_if(ret != 1, -EINVAL,
+				 "Invalid integer in file %s at index %zu", path, i);
 	}
 
 	*number = t;
