 #ADD_TESTS(cmocka-proc-dbus-aul-group "${UNIT_TESTS_CFLAGS}" "-Wl,--wrap=fread_int,--wrap=fread_uint,--wrap=fread_ulong,--wrap=proc_set_group,--wrap=proc_get_oom_score_adj,--wrap=resourced_notify -O0" cmocka-proc-dbus-aul-group.c)
diff --git a/tests/test-integer-read-errors.c b/tests/test-integer-read-errors.c
new file mode 100644
index 0000000..cc35af0
--- /dev/null
+++ b/tests/test-integer-read-errors.c
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stdarg.h>
+#include <stddef.h>
+#include <setjmp.h>
+#include <cmocka.h>
+#include <sys/types.h>
+#include <stdint.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "file-helper.h"
+
+static void test_invalid_samples(void **state)
+{
+	(void)state;
+	const char *samples[] = {"invalid\n", "1 invalid\n"};
+	for (size_t n = 0; n < 2; n++) {
+		char path[] = "test-integer-read-XXXXXX";
+		int fd = mkstemp(path);
+		int32_t i = 99;
+		u_int32_t u = 99;
+		unsigned long ul = 99;
+		unsigned long long ull = 99;
+		assert_true(fd >= 0);
+		assert_int_equal(write(fd, samples[n], strlen(samples[n])), strlen(samples[n]));
+		assert_int_equal(close(fd), 0);
+		assert_int_equal(fread_nth_int(path, n, &i), -EINVAL);
+		assert_int_equal(fread_nth_uint(path, n, &u), -EINVAL);
+		assert_int_equal(fread_nth_ulong(path, n, &ul), -EINVAL);
+		assert_int_equal(fread_nth_ulonglong(path, n, &ull), -EINVAL);
+		assert_int_equal(i, 99); assert_int_equal(u, 99);
+		assert_int_equal(ul, 99); assert_int_equal(ull, 99);
+		/* A valid preceding field must still be accepted. */
+		if (n) {
+			assert_int_equal(fread_int(path, &i), 0);
+			assert_int_equal(i, 1);
+		}
+		assert_int_equal(unlink(path), 0);
+	}
+}
+int main(void)
+{
+	const struct CMUnitTest tests[] = {cmocka_unit_test(test_invalid_samples)};
+	return cmocka_run_group_tests(tests, NULL, NULL);
+}
