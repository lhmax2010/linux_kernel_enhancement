 ADD_TESTS(test-file-write-errors "${UNIT_TESTS_CFLAGS}"
   "-Wl,--wrap=fopen,--wrap=fopen64,--wrap=fputs,--wrap=fflush,--wrap=fclose" test-file-write-errors.c)
 
