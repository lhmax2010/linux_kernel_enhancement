From 3f59151b2f8b9f2d506181d61722d1d7b9555c7c Mon Sep 17 00:00:00 2001
From: Hao Lin <hao.lin@samsung.com>
Date: Wed, 4 Nov 2026 22:05:39 +0800
Subject: [PATCH 2/9] file-helper: report flush and close failures

fputs success can only mean data entered the stdio buffer. The previous
cleanup fclose discarded failures, hiding rejected sysfs settings.
Check write, flush and close explicitly, always close the stream and keep
the first error with an EIO fallback. Add fault-injected completion tests.
No rollback is promised after a partially completed write.

Based on analysis of He Fangyu's fix 16d6125d
---
 src/common/file-helper.c       | 29 ++++++++++----
 tests/CMakeLists.txt           |  3 ++
 tests/test-file-write-errors.c | 69 ++++++++++++++++++++++++++++++++++
 3 files changed, 93 insertions(+), 8 deletions(-)
 create mode 100644 tests/test-file-write-errors.c

diff --git a/src/common/file-helper.c b/src/common/file-helper.c
index 28ffff9..7281672 100644
--- a/src/common/file-helper.c
+++ b/src/common/file-helper.c
@@ -36,22 +36,35 @@
 
 int fwrite_str(const char *path, const char *str)
 {
-	_cleanup_fclose_ FILE *f = NULL;
-	int ret;
+	FILE *f;
+	int ret = RESOURCED_ERROR_NONE;
 
 	assert(path);
 	assert(str);
 
 	f = fopen(path, "w");
-	ret_value_errno_msg_if(!f, -errno,
+	ret_value_errno_msg_if(!f, -(errno ?: EIO),
 			       "Fail to open file %s", path);
 
+	/* Command nodes requiring exactly one submission must use a
+	 * dedicated single write, not this buffered helper.
+	 */
 	errno = 0;
-	ret = fputs(str, f);
-	ret_value_errno_msg_if(ret == EOF, -(errno ?: EIO),
-			       "Fail to write file");
-
-	return RESOURCED_ERROR_NONE;
+	if (fputs(str, f) == EOF)
+		ret = -(errno ?: EIO);
+	if (ret == RESOURCED_ERROR_NONE) {
+		errno = 0;
+		if (fflush(f) == EOF)
+			ret = -(errno ?: EIO);
+	}
+	errno = 0;
+	if (fclose(f) == EOF && ret == RESOURCED_ERROR_NONE)
+		ret = -(errno ?: EIO);
+	if (ret < 0) {
+		errno = -ret;
+		ETRACE_ERRNO_MSG("Fail to write file %s", path);
+	}
+	return ret;
 }
 
 int fwrite_int(const char *path, const int number)
