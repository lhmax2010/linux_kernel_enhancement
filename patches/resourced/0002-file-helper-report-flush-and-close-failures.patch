diff --git a/tests/test-file-write-errors.c b/tests/test-file-write-errors.c
new file mode 100644
index 0000000..7f3efa3
--- /dev/null
+++ b/tests/test-file-write-errors.c
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stdarg.h>
+#include <stddef.h>
+#include <setjmp.h>
+#include <cmocka.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <errno.h>
+#include <string.h>
+#include "file-helper.h"
+
+static FILE *const mock_stream = (FILE *)(uintptr_t)0x1234;
+static int puts_fail, flush_fail, close_fail, saved_error, flushes, closes;
+FILE *__real_fopen(const char *path, const char *mode);
+FILE *__real_fopen64(const char *path, const char *mode);
+int __real_fputs(const char *str, FILE *stream);
+int __real_fflush(FILE *stream);
+int __real_fclose(FILE *stream);
+FILE *__wrap_fopen(const char *path, const char *mode)
+{
+	return !strcmp(path, "/task15/mock-file") ? mock_stream : __real_fopen(path, mode);
+}
+FILE *__wrap_fopen64(const char *path, const char *mode)
+{
+	return !strcmp(path, "/task15/mock-file") ? mock_stream : __real_fopen64(path, mode);
+}
+int __wrap_fputs(const char *str, FILE *stream)
+{
+	if (stream != mock_stream) return __real_fputs(str, stream);
+	assert_string_equal(str, "value"); errno = saved_error;
+	return puts_fail ? EOF : 1;
+}
+int __wrap_fflush(FILE *stream)
+{
+	if (stream != mock_stream) return __real_fflush(stream);
+	flushes++; errno = saved_error;
+	return flush_fail ? EOF : 0;
+}
+int __wrap_fclose(FILE *stream)
+{
+	if (stream != mock_stream) return __real_fclose(stream);
+	closes++; errno = close_fail ? EBADF : 0;
+	return close_fail ? EOF : 0;
+}
+static void test_write_completion(void **state)
+{
+	(void)state;
+	/* Success, fputs failure, delayed flush failure, close-only failure,
+	 * and errno-less flush failure. Later close errors cannot replace
+	 * an earlier ENOSPC/EIO result.
+	 */
+	const int cases[][5] = {
+		{0, 0, 0, 0, 0}, {1, 0, 1, ENOSPC, -ENOSPC},
+		{0, 1, 1, EIO, -EIO}, {0, 0, 1, 0, -EBADF},
+		{0, 1, 1, 0, -EIO},
+	};
+	for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+		puts_fail = cases[i][0]; flush_fail = cases[i][1];
+		close_fail = cases[i][2]; saved_error = cases[i][3];
+		flushes = closes = 0;
+		assert_int_equal(fwrite_str("/task15/mock-file", "value"), cases[i][4]);
+		assert_int_equal(flushes, !puts_fail); assert_int_equal(closes, 1);
+	}
+}
+int main(void)
+{
+	const struct CMUnitTest tests[] = {cmocka_unit_test(test_write_completion)};
+	return cmocka_run_group_tests(tests, NULL, NULL);
+}
