From 152161a1d80b2dbf244f044824699df77f84d5d1 Mon Sep 17 00:00:00 2001
From: Hao Lin <hao.lin@samsung.com>
Date: Wed, 4 Nov 2026 22:05:39 +0800
Subject: [PATCH 1/9] cgroup: submit force_reclaim through a single write

Buffered writes can hide failures or resubmit a positive legacy page-count
return as a short write. Keep cgroup_write_node_uint32 and its callers,
but route only memory.force_reclaim through one unbuffered syscall.
Accept positive legacy and fixed-kernel results; report zero/errors and
do not retry or turn a successful submission into failure on close.
Check path truncation. Add mocked return and error regression cases.

Based on analysis of He Fangyu's fix 16d6125d
---
 src/common/cgroup/cgroup.c |  30 +++++++++-
 tests/CMakeLists.txt       |   3 +
 tests/test-reclaim-io.c    | 114 +++++++++++++++++++++++++++++++++++++
 3 files changed, 145 insertions(+), 2 deletions(-)
 create mode 100644 tests/test-reclaim-io.c

diff --git a/src/common/cgroup/cgroup.c b/src/common/cgroup/cgroup.c
index 59fd9b7..408daee 100644
--- a/src/common/cgroup/cgroup.c
+++ b/src/common/cgroup/cgroup.c
@@ -123,8 +123,34 @@ int cgroup_write_node_uint32(const char *cgroup_name,
 {
 	int ret;
 	char buf[MAX_PATH_LENGTH];
-	snprintf(buf, sizeof(buf), "%s/%s", cgroup_name, file_name);
-	ret = fwrite_uint(buf, value);
+
+	ret = snprintf(buf, sizeof(buf), "%s/%s", cgroup_name, file_name);
+	if (ret < 0 || (size_t)ret >= sizeof(buf))
+		return -ENAMETOOLONG;
+
+	if (!strcmp(file_name, MEMCG_FORCE_RECLAIM)) {
+		char number[11]; /* UINT32_MAX and its terminating NUL. */
+		ssize_t written;
+		int fd, len = snprintf(number, sizeof(number), "%u", value);
+
+		fd = open(buf, O_WRONLY | O_CLOEXEC);
+		if (fd < 0)
+			return -(errno ?: EIO);
+
+		/* Legacy callbacks may return reclaimed pages, not bytes.
+		 * Submit once: retrying a short write would repeat the command.
+		 */
+		errno = 0;
+		written = write(fd, number, len);
+		ret = written > 0 ? RESOURCED_ERROR_NONE :
+			-(written < 0 && errno ? errno : EIO);
+		if (close(fd) < 0)
+			_SE("Failed to close %s after reclaim request: %m", buf);
+		if (ret < 0)
+			errno = -ret;
+	} else {
+		ret = fwrite_uint(buf, value);
+	}
 	if (ret == RESOURCED_ERROR_NONE)
 		_SD("cgroup_buf = %s, value = %u\n", buf, value);
 	else
